# Where the Express API runs (must match PORT in backend/.env). Server-side only:
# the browser calls /api on this app, and app/api/[...path]/route.js forwards it.
# Use 127.0.0.1 rather than localhost (avoids IPv6 lookup issues, esp. on Windows).
API_URL=http://127.0.0.1:5000

# Must equal JWT_SECRET in backend/.env — used by proxy.js and server
# components to verify the session cookie without a network round trip.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_NAME=dt_token

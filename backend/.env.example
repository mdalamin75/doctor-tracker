# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# ─── Auth ───────────────────────────────────────────────
# Must be the SAME value as JWT_SECRET in frontend/.env.local
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
COOKIE_NAME=dt_token

# Comma-separated list of allowed browser origins (only needed if the
# browser calls the API directly instead of through the Next.js proxy)
CORS_ORIGIN=http://localhost:3000

# Timezone used to bucket dates in dashboard analytics
APP_TIMEZONE=Asia/Dhaka

# ─── Initial admin (used by `npm run seed` / `npm run create-admin`) ───
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@doctortracker.dev
ADMIN_PASSWORD=Admin@12345
